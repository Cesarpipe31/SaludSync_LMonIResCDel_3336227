<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard Admin IPS | SaludSync</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="../../assets/css/styles.css" rel="stylesheet">
  <link href="../../assets/css/plataforma.css" rel="stylesheet">
  <link href="../../assets/css/dashboard.css" rel="stylesheet">
</head>
<body data-page="dashboard_admin">

  <div id="app-header"></div>

  <main class="container-xl py-4">
    <div class="alert alert-danger d-none" id="sinAcceso">🔒 Esta vista está reservada para el rol <strong>Admin IPS</strong>. <a href="../../index.html" class="alert-link">Volver al inicio</a>.</div>

    <div id="contenido">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb small mb-2">
          <li class="breadcrumb-item"><a href="../../index.html">Inicio</a></li>
          <li class="breadcrumb-item">Dashboard</li>
          <li class="breadcrumb-item active" aria-current="page">Admin IPS</li>
        </ol>
      </nav>

      <div class="page-head d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
          <span class="badge badge-mod">Pantalla 15.1</span>
          <h1 class="h3 fw-bold mb-0 mt-1">Dashboard Operativo y Asistencial</h1>
          <p class="text-muted mb-0">Institución: <strong data-inst-nombre>—</strong> · <span id="fechaHoy"></span></p>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
          <span class="live-chip"><span class="live-dot"></span><span class="reloj" id="reloj">--:--:--</span><span class="text-muted">· act. <span id="actualizado">—</span></span></span>
          <select id="selSede" class="form-select w-auto" aria-label="Sede"></select>
          <button type="button" class="btn btn-outline-primary" id="btnActualizar">↻ Actualizar</button>
        </div>
      </div>

      <div class="row g-3 mb-3" id="kpis"></div>
      <p class="text-muted small mb-4">KPIs de citas desde la vista <span class="fuente">vw_kpi_citas_dia</span>; sala de espera, actividad por hora y consultorios se calculan desde <span class="fuente">cita_medica</span>.</p>

      <div class="row g-3 mb-3">
        <div class="col-lg-8">
          <div class="card panel h-100">
            <div class="card-header section-title d-flex flex-wrap justify-content-between align-items-center gap-2"><span>🕒 Actividad asistencial por hora (hoy)</span><span class="leyenda-e" id="leyenda"></span></div>
            <div class="table-responsive"><table class="table table-ss align-middle mb-0">
              <thead><tr><th>Hora</th><th style="min-width:220px">Pacientes por estado</th><th>Total</th><th>Espera</th><th>Atend.</th><th>Inasist.</th></tr></thead><tbody id="tablaHoras"></tbody></table></div>
          </div>
        </div>
        <div class="col-lg-4 d-flex flex-column gap-3">
          <div class="card panel"><div class="card-header section-title">⚡ Accesos rápidos</div>
            <div class="card-body d-grid gap-2">
              <button type="button" class="btn-quick" data-go="../citas/agendamiento_cita.html"><span class="q-ico">🗓️</span><span>Agendar cita<small>Buscar disponibilidad y asignar</small></span></button>
              <button type="button" class="btn-quick" data-go="../pacientes/registro_paciente.html"><span class="q-ico">🧑‍🤝‍🧑</span><span>Registrar paciente<small>Alta en el directorio</small></span></button>
              <button type="button" class="btn-quick" data-go="../citas/mesa_recepcion.html"><span class="q-ico">🛎️</span><span>Mesa de recepción<small>Check-in y estados</small></span></button>
              <button type="button" class="btn-quick" data-go="../agenda/calendario_agenda.html"><span class="q-ico">📆</span><span>Calendario de agenda<small>Disponibilidad médica</small></span></button>
            </div></div>
          <div class="card panel flex-grow-1"><div class="card-header section-title">📊 Citas por día (−2 a +4 días)</div><div class="card-body"><div class="chart-box" id="graficoDias"></div></div></div>
        </div>
      </div>

      <div class="card panel mb-5">
        <div class="card-header section-title d-flex flex-wrap justify-content-between align-items-center gap-2"><span>🚪 Estado de consultorios físicos</span><div class="d-flex flex-wrap gap-2" id="chipsSede"></div></div>
        <div class="card-body"><div class="d-flex flex-wrap gap-3 mb-3 small" id="resumenCons"></div><div class="row g-3" id="gridCons"></div></div>
      </div>
    </div>
  </main>

  <!-- Detalle por hora -->
  <div class="modal fade" id="modalHora" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
    <div class="modal-header"><h2 class="modal-title h5" id="horaTitulo">Detalle</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
    <div class="modal-body" id="horaCuerpo"></div>
    <div class="modal-footer"><a href="../citas/mesa_recepcion.html" class="btn btn-primary">Ir a la mesa de recepción</a><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button></div></div></div></div>

  <!-- Detalle consultorio -->
  <div class="modal fade" id="modalCons" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
    <div class="modal-header"><h2 class="modal-title h5" id="consTitulo">Consultorio</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
    <div class="modal-body" id="consCuerpo"></div>
    <div class="modal-footer"><a href="../consultorios/matriz_ocupacion.html" class="btn btn-outline-primary">Matriz de ocupación</a><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button></div></div></div></div>

  <div id="app-footer"></div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="../../assets/js/main.js"></script>
  <script src="../../assets/js/dashboard.js"></script>
</body>
</html>